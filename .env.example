# Copy this file to .env and fill in real values, then run:
#   npm start
#   -- or --
#   ./scripts/start-dashboard.ps1
#
# .env is gitignored. Never commit it or paste real values into chat/issues/PRs.
# GitHub Actions secrets cannot be read back out to your machine, so local
# credentials must be entered here (or via the interactive prompts) instead.

BOOMI_ACCOUNT_ID=
BOOMI_USERNAME=
BOOMI_TOKEN=

# Optional. Only set this for the EU/GB Boomi platform.
# BOOMI_API_HOST=https://api.platform.gb.boomi.com

GITHUB_TOKEN=
GITHUB_OWNER=Rajesh10222002
GITHUB_REPO=Boomi-CICD

DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional. Defaults to 3000.
# PORT=3000
